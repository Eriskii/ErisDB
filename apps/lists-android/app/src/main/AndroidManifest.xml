<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Iroh dials relays and hole-punches over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ErisAuth is how this app gets into ErisDB. Android shows an app
         only the packages it says it looks for. -->
    <queries>
        <package android:name="dev.eris.auth" />
    </queries>

    <!--
      allowBackup="false" — nothing this app holds belongs in Google's
      cloud or on a device-to-device transfer. The app's Iroh key is its
      credential, sealed with the address of its ErisDB under a keystore
      key that cannot leave this phone, and so would arrive elsewhere as
      noise; and everything else is a cache of the core, which reseeds on
      first sync. There is nothing to back up, so nothing is.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ErisDBLists">
        <!-- adjustNothing: the framework neither pans nor resizes for the
             IME; safeDrawingPadding consumes the ime inset in Compose. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
