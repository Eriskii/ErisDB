# Install as /etc/erisdb/poker.env, mode 0600, owned by root: systemd reads it
# as the manager. erisdb-poker.service names it; poke.sh knows nothing else.

# Where the core listens. The poker runs on the same host as the core, so
# this is the loopback TCP listener.
ERISDB_URL=http://127.0.0.1:7700

# A permanent token scoped to exactly one thing: writing the tick.
#   erisdb mint --facets system --verbs write --no-expiry
ERISDB_POKER_TOKEN=replace-me
