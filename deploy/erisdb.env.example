# Install as /etc/erisdb/erisdb.env, mode 0600, owned by root: systemd reads it
# as the manager, before dropping to the erisdb user.
# It is read verbatim — no shell, no quoting, no expansion.

# The store. The only stateful thing in the system.
DATABASE_URL=postgres://erisdb:password@127.0.0.1/erisdb

# Signs every capability token AND derives the iroh endpoint id clients dial.
# Rotating it invalidates every outstanding token and moves the server's
# address. Generate with:
#   openssl rand -hex 32
ERISDB_SECRET=replace-me

# The plain-TCP listener. Loopback only: the TCP path has no transport
# security, so anything beyond this host goes over iroh or behind TLS.
ERISDB_LISTEN=127.0.0.1:7700

# One-shot executable plugins. Omit this variable for a core with none.
ERISDB_PLUGIN_DIR=/etc/erisdb/plugins.d

# Required by deploy/plugins/openai.json. The core copies only variables the
# manifest names into each fresh plugin process; clients never receive it.
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
